@model PracticeWebProjectII.Models.SI

@{
    ViewData["Title"] = "Simple Interest Calculator";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Index" method="post">
    @Html.AntiForgeryToken()
    <div>
        <label asp-for="principal">Principal</label>
        <input asp-for="principal" />
    </div>
    <div>
        <label asp-for="rate">Rate (%)</label>
        <input asp-for="rate" />
    </div>
    <div>
        <label asp-for="time">Time (years)</label>
        <input asp-for="time" />
    </div>
    <div>
        <button type="submit">Calculate</button>
    </div>
</form>

@if (ViewData["Result"] != null)
{
    <div>
        <h3>Result</h3>
        <p>Simple Interest: @ViewData["Result"]</p>
    </div>
}
